# Ubuntu 目标机示例环境（与本地开发默认值对齐）
# 复制到 /opt/perf-app/.env 后修改密钥与 APP_BASE_URL

# PostgreSQL（与 bootstrap 默认一致）
DATABASE_URL="postgresql://perf:perf@127.0.0.1:5432/perf?schema=public"

# JWT 会话签名密钥 (openssl rand -hex 32)
JWT_SECRET="change-me-to-a-32byte-hex-string"

# 通知渠道密钥加密（AES-256-GCM）(openssl rand -hex 32)
NOTIFY_SECRET_KEY="change-me-to-a-32byte-hex-string"

# MinIO（同机部署用 127.0.0.1；本方案不迁移对象数据，仅需服务可用）
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=perf-attachments
# 浏览器预签名下载（员工可访问的 IP/域名；HTTPS 反代时可按需调整）
# MINIO_PUBLIC_ENDPOINT=your-server-ip-or-domain
# MINIO_PUBLIC_PORT=9000
# MINIO_PUBLIC_USE_SSL=false

# 应用对外地址（Nginx HTTPS 后改为 https://你的IP或域名）
APP_BASE_URL=https://127.0.0.1
# COOKIE_SECURE=true
