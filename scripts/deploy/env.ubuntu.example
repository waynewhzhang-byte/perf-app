# Ubuntu 目标机环境模板（复制为 /opt/perf-app/.env 后改密钥与域名）
#
# 【附件访问 — 必读】
# 默认推荐「应用代理」模式：不要设置 MINIO_PUBLIC_*。
# 浏览器经 https://你的站点/api/attachments/<id>/view?proxy=1 取文件，
# 与站点同域，避免对 MinIO:9000 误用 HTTPS 导致 ERR_SSL_PROTOCOL_ERROR。
#
# 错误示例（会导致附件打不开）:
#   MINIO_PUBLIC_ENDPOINT=1.92.206.86
#   MINIO_PUBLIC_PORT=9000
#   MINIO_PUBLIC_USE_SSL=true   ← 9000 是 HTTP API，不是 HTTPS
#
# 若必须浏览器直连 MinIO，请用 Nginx HTTPS 反代（默认 8443→9000），并设置:
#   MINIO_PUBLIC_ENDPOINT=<公网IP或域名>
#   MINIO_PUBLIC_PORT=8443
#   MINIO_PUBLIC_USE_SSL=true
# 一键配置: sudo ./scripts/deploy/setup-minio-nginx-ssl.sh --server-name <IP>
# 一键修正 .env: sudo ./scripts/deploy/fix-attachments.sh --server-name <IP>

# PostgreSQL（同机）
DATABASE_URL="postgresql://perf:perf@127.0.0.1:5432/perf?schema=public"

# JWT / 通知加密密钥 (openssl rand -hex 32) — 恢复旧库时须与源环境一致
JWT_SECRET="change-me-to-a-32byte-hex-string"
NOTIFY_SECRET_KEY="change-me-to-a-32byte-hex-string"

# MinIO SDK（同机务必 127.0.0.1 + HTTP；勿填公网 IP）
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=perf-attachments

# —— 附件「应用代理」模式：以下三项保持注释 ——
# MINIO_PUBLIC_ENDPOINT=
# MINIO_PUBLIC_PORT=8443
# MINIO_PUBLIC_USE_SSL=true

# 应用对外地址（Nginx 自签名 HTTPS 后改为真实 IP/域名）
APP_BASE_URL=https://YOUR_SERVER_IP_OR_DOMAIN
# COOKIE_SECURE=true

# 附件上传上限（可选）
# UPLOAD_MAX_FILE_SIZE_MB=10
# UPLOAD_MAX_FILES_PER_ITEM=20
