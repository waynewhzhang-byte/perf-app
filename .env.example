# PostgreSQL
DATABASE_URL="postgresql://perf:perf@localhost:5432/perf?schema=public"

# JWT 会话签名密钥 (openssl rand -hex 32)
JWT_SECRET="change-me-to-a-32byte-hex-string"

# 通知渠道密钥加密（AES-256-GCM）(openssl rand -hex 32)
NOTIFY_SECRET_KEY="change-me-to-a-32byte-hex-string"

# MinIO（SDK 使用 API 端口 9000；Web 控制台端口与 API 无关）
# 本机 minio server：RootUser/RootPass 默认 minioadmin / minioadmin
#
# 生产同机部署：MINIO_ENDPOINT 用 127.0.0.1（勿用公网 IP，易 ETIMEDOUT）
#
# 【附件访问】
# 默认推荐：不设置 MINIO_PUBLIC_* → 浏览器经应用代理
#   /api/attachments/<id>/view?proxy=1（与站点同域 HTTPS，最稳）
#
# 切勿: MINIO_PUBLIC_USE_SSL=true 且 PORT=9000
#   （9000 是 HTTP；浏览器 https://IP:9000 → ERR_SSL_PROTOCOL_ERROR）
#
# 可选直连 MinIO：先 Nginx HTTPS 反代（如 8443→9000），再设:
#   MINIO_PUBLIC_ENDPOINT=公网IP或域名
#   MINIO_PUBLIC_PORT=8443
#   MINIO_PUBLIC_USE_SSL=true
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=perf-attachments
# MINIO_PUBLIC_ENDPOINT=your-public-host-or-ip
# MINIO_PUBLIC_PORT=8443
# MINIO_PUBLIC_USE_SSL=true

# 应用 baseUrl（用于通知中插入链接；生产 Nginx HTTPS 后用 https://域名或IP）
APP_BASE_URL=http://localhost:3000
# 会话 Cookie Secure 属性；默认按 APP_BASE_URL 协议判断，HTTPS=true，HTTP=false
# COOKIE_SECURE=false

# 附件上传（可选，默认 10MB / 每项 20 个）
# UPLOAD_MAX_FILE_SIZE_MB=10
# UPLOAD_MAX_FILES_PER_ITEM=20
